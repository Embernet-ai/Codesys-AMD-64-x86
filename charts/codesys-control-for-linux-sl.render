---
apiVersion: v1
kind: ConfigMap
metadata:
  name: codesys-control-for-linux-sl-embernet001-sidecar-proxy
  labels:
    app.kubernetes.io/name: codesys-control-for-linux-sl
    app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
    app.kubernetes.io/managed-by: Helm
data:
  nginx.conf: |
    worker_processes auto;
    error_log /tmp/error.log warn;
    pid       /tmp/nginx.pid;

    events {
        worker_connections 256;
    }

    http {
        include       /etc/nginx/mime.types;
        default_type  application/octet-stream;

        client_body_temp_path /tmp/client_body;
        proxy_temp_path       /tmp/proxy;
        fastcgi_temp_path     /tmp/fastcgi;
        uwsgi_temp_path       /tmp/uwsgi;
        scgi_temp_path        /tmp/scgi;

        access_log /tmp/access.log;
        sendfile   on;
        keepalive_timeout 65;
        client_max_body_size 10m;

        gzip on;
        gzip_types
            text/plain
            text/css
            text/xml
            application/json
            application/javascript
            application/xml
            application/xml+rss
            text/javascript
            image/svg+xml;

        map $http_upgrade $connection_upgrade {
            default upgrade;
            ''      close;
        }

        map $http_x_embernet_proxy_prefix $embernet_root {
            ""      "/";
            default "$http_x_embernet_proxy_prefix/";
        }
        map $http_x_embernet_proxy_prefix $embernet_dot {
            ""      "./";
            default "$http_x_embernet_proxy_prefix/";
        }

        upstream app_backend {
            server 127.0.0.1:8080;
            keepalive 16;
        }

        server {
            listen 8081;
            server_name _;

            location = /sidecar-health {
                access_log off;
                add_header Content-Type application/json;
            }

            location / {
                proxy_pass http://app_backend;

                proxy_set_header Host              $host;
                proxy_set_header X-Real-IP         $remote_addr;
                proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
                proxy_set_header X-Forwarded-Host  $host;
                proxy_set_header X-Forwarded-Prefix "/";

                proxy_set_header Upgrade    $http_upgrade;
                proxy_set_header Connection $connection_upgrade;

                proxy_connect_timeout  60s;
                proxy_read_timeout    300s;
                proxy_send_timeout    300s;

                proxy_set_header Accept-Encoding "";

                sub_filter_once off;
                sub_filter_types text/html text/css application/javascript application/json;


                sub_filter 'src="/'      'src="$embernet_root' ;
                sub_filter "src='/"      "src='$embernet_root" ;
                sub_filter 'href="/'     'href="$embernet_root' ;
                sub_filter "href='/"     "href='$embernet_root" ;
                sub_filter 'action="/'   'action="$embernet_root' ;
                sub_filter "action='/"   "action='$embernet_root" ;

                sub_filter '"/api/'      '"${embernet_root}api/' ;
                sub_filter "'/api/"      "'${embernet_root}api/" ;
                sub_filter '"/public/'   '"${embernet_root}public/' ;
                sub_filter "'/public/"   "'${embernet_root}public/" ;

                sub_filter '"/webvisu'   '"${embernet_root}webvisu' ;
                sub_filter "'/webvisu"   "'${embernet_root}webvisu" ;

                sub_filter 'url(/'       'url(${embernet_root}' ;
                sub_filter "url('/"      "url('${embernet_root}" ;
                sub_filter 'url("/'      'url("${embernet_root}' ;

                sub_filter '</head>' '<base href="/" />\n</head>';

                add_header X-Proxy-By     "embernet-sidecar" always;
                add_header X-Proxy-Target "127.0.0.1:8080" always;
            }
        }
    }

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: codesys-control-for-linux-sl-embernet001
  labels:
    app.kubernetes.io/name: codesys-control-for-linux-sl
    app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
    app.kubernetes.io/managed-by: Helm
spec:
  accessModes:
    - "ReadWriteOnce"
  resources:
    requests:
      storage: "5Gi"

---
apiVersion: v1
kind: Service
metadata:
  name: codesys-control-for-linux-sl-embernet001
  labels:
    app.kubernetes.io/name: codesys-control-for-linux-sl
    app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
    app.kubernetes.io/managed-by: Helm
    embernet.ai/store-app: "true"
    embernet.ai/gui-type: "web"
    embernet.ai/app-name: "codesys-control-for-linux-sl"
    embernet.ai/gui-port: "8081"
    app: "codesys-control-for-linux-sl-embernet001"
  annotations:
    flux.embernet.ai/expose: "true"
    flux.embernet.ai/service-name: "codesys-control-for-linux-sl-embernet001"
    flux.embernet.ai/port: "8080"
    flux.embernet.ai/role-attributes: "gui-services"
    embernet.ai/app-icon: "https://embernet-ai.github.io/Codesys-AMD-64-x86/icon.png"
spec:
  type: ClusterIP
  ports:
    - port: 11740
      targetPort: 11740
      protocol: TCP
      name: runtime
    - port: 1217
      targetPort: gateway
      protocol: TCP
      name: gateway
    - port: 4840
      targetPort: opcua
      protocol: TCP
      name: opcua
    - port: 8080
      targetPort: webvisu
      protocol: TCP
      name: webvisu
    - port: 8081
      targetPort: proxy-http
      protocol: TCP
      name: proxy-http
  selector:
    app.kubernetes.io/name: codesys-control-for-linux-sl
    app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: codesys-control-for-linux-sl-embernet001
  labels:
    app.kubernetes.io/name: codesys-control-for-linux-sl
    app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
    app.kubernetes.io/managed-by: Helm
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: codesys-control-for-linux-sl
      app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
  template:
    metadata:
      labels:
        app.kubernetes.io/name: codesys-control-for-linux-sl
        app.kubernetes.io/instance: codesys-control-for-linux-sl-embernet001
        embernet.ai/store-app: "true"
        embernet.ai/gui-type: "web"
        embernet.ai/app-name: "codesys-control-for-linux-sl"
        embernet.ai/gui-port: "8081"
        app: "codesys-control-for-linux-sl-embernet001"
      annotations:
        checksum/sidecar-proxy: 5617739aa3c324b5b69ba4b73fc8dddc4f2261c54788b47c0811b1b928dc646b
        embernet.ai/app-icon: "https://embernet-ai.github.io/Codesys-AMD-64-x86/icon.png"
    spec:
      dnsPolicy: ClusterFirst

      initContainers:
        - name: seed-workdir
          image: "ghcr.io/embernet-ai/codesys-control-sl:4.22.0.0"
          imagePullPolicy: IfNotPresent
          command:
            - sh
            - -c
            - |
              set -e
              cp -an /var/opt/codesys/. /seed/ 2>/dev/null || true
              echo "Seeded persistence from image. Contents of /seed:"
              ls -la /seed
          volumeMounts:
            - name: data
              mountPath: /seed

      containers:
        - name: codesys-control-for-linux-sl
          securityContext:
            allowPrivilegeEscalation: true
            privileged: true
          image: "ghcr.io/embernet-ai/codesys-control-sl:4.22.0.0"
          imagePullPolicy: IfNotPresent
          ports:
            - name: runtime
              containerPort: 11740
              protocol: TCP
            - name: gateway
              containerPort: 1217
              protocol: TCP
            - name: opcua
              containerPort: 4840
              protocol: TCP
            - name: webvisu
              containerPort: 8080
              protocol: TCP
          volumeMounts:
            - name: data
              mountPath: /var/opt/codesys
          resources:
            limits:
              cpu: 1000m
              memory: 1Gi
            requests:
              cpu: 500m
              memory: 512Mi

        - name: sidecar-proxy
          image: "nginxinc/nginx-unprivileged:1.27-alpine"
          imagePullPolicy: IfNotPresent
          ports:
            - name: proxy-http
              containerPort: 8081
              protocol: TCP
          volumeMounts:
            - name: sidecar-proxy-config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: sidecar-proxy-tmp
              mountPath: /tmp
            - name: sidecar-proxy-cache
              mountPath: /var/cache/nginx
            - name: sidecar-proxy-run
              mountPath: /var/run
          resources:
            limits:
              cpu: 200m
              memory: 128Mi
            requests:
              cpu: 25m
              memory: 32Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            runAsGroup: 65534
            runAsNonRoot: true
            runAsUser: 65534
          livenessProbe:
            httpGet:
              path: /sidecar-health
              port: 8081
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /sidecar-health
              port: 8081
            initialDelaySeconds: 3
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 3
          startupProbe:
            httpGet:
              path: /sidecar-health
              port: 8081
            initialDelaySeconds: 2
            periodSeconds: 3
            timeoutSeconds: 3
            failureThreshold: 10

      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: codesys-control-for-linux-sl-embernet001
        - name: sidecar-proxy-config
          configMap:
            name: codesys-control-for-linux-sl-embernet001-sidecar-proxy
        - name: sidecar-proxy-tmp
          emptyDir:
            sizeLimit: 64Mi
        - name: sidecar-proxy-cache
          emptyDir:
            sizeLimit: 64Mi
        - name: sidecar-proxy-run
          emptyDir:
            sizeLimit: 1Mi
